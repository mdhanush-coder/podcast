# EngineX
EDITOR_API_KEY=
EDITOR_TEMPLATE_ID=

# Auth.js — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Needed when self-hosting (next start, Docker). Not needed on Vercel.
AUTH_TRUST_HOST=true
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (Neon or Supabase connection string). The runs table is created on first use.
DATABASE_URL=

# Public site
SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@deepsoch.ai
RUNS_PER_DAY=10
