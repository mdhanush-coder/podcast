# EngineX
EDITOR_API_KEY=
EDITOR_TEMPLATE_ID=

# Auth.js — generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Needed when self-hosting (next start, Docker). Not needed on Vercel.
AUTH_TRUST_HOST=true
# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase Postgres: Connect > Transaction pooler URI (port 6543). The runs table is created on first use.
DATABASE_URL=

# Public site
SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@deepsoch.ai
RUNS_PER_DAY=10

# Supabase Storage (S3 API): Project Settings > Storage > S3 Connection / S3 Access Keys
# Leave empty until the podcast_edit pipeline version with storage is published.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
